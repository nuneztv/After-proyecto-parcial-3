# Copy to client/.env.local. NEXT_PUBLIC_* values are public (shipped to the browser).

# Express API (no trailing slash; request paths already start with /api)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase Realtime (admin live updates). Leave empty to run without Realtime.
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). NEVER the secret key: this value ships to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The user app also uses these two values for live event updates (Realtime)

# Optional: support address shown in Profile > Help & Support. Leave empty if there is none
# (the app then says contact is not configured instead of showing an invented address)
NEXT_PUBLIC_SUPPORT_EMAIL=
