# Copy to client/.env.local and fill in. NEXT_PUBLIC_* values end up in the browser bundle:
# never put a secret here (the Supabase secret key lives only in server/.env)

# Express API (server/)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase project URL and PUBLISHABLE key, used only for Realtime (Broadcast)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
