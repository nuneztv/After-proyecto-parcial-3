PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins (client runs on 3001 with `npm run dev`)
CLIENT_ORIGIN=http://localhost:3001
# Public URL of the user app. Supabase redirects to <CLIENT_URL>/reset-password and
# <CLIENT_URL>/auth/callback: add both to Supabase > Authentication > URL Configuration > Redirect URLs
CLIENT_URL=http://localhost:3001

# Supabase Postgres: Project Settings > Database > Connection string > "Transaction pooler"
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=

# Supabase API: Project Settings > API Keys. Secret key: server only, never ship it to the client
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Supabase Storage: public bucket for event images (created at startup if missing)
IMAGES_BUCKET=event-images

# Allow POST /api/auth/admin/register. Set to false after creating the admin accounts
ADMIN_SIGNUP_ENABLED=true
