{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "main": "src/app.ts",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:init": "tsx src/db/init.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --experimental-test-module-mocks --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
